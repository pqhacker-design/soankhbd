rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write for app documents
    match /users/{userId} {
      allow read, write: if true;
    }
    match /lesson_plans/{planId} {
      allow read, write: if true;
    }
    match /materials/{materialId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
